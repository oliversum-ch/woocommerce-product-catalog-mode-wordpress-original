msgid "Before Single Product"
msgstr "Voor het enkele product"

msgid "Before Single Product Summary"
msgstr "Voor de samenvatting van het enkele product"

msgid "In Single Product Summary"
msgstr "In de samenvatting van het enkele product"

msgid "Before Meta Information"
msgstr "Voor de meta-informatie"


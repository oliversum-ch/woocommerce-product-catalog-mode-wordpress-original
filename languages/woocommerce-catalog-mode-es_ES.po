msgstr "CSS personalizado"

msgid "Add some stylesheet if you want."
msgstr "Añada su propia hoja de estilos si lo desea."

msgid "Before Single Product"
msgstr "Antes del producto individual"

msgid "Before Single Product Summary"
msgstr "Antes del resumen del producto"

msgid "In Single Product Summary"
msgstr "En el resumen del producto"

msgid "Before Meta Information"
msgstr "Antes de la metainformación"

